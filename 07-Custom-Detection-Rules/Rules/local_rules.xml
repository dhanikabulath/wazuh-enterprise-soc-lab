<group name="local,syslog,sshd,">

  <rule id="100100" level="8">
    <if_group>sysmon_event1</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.system.message" type="pcre2">(?i)SOCLabDetection</field>
    <description>Custom detection: SOC lab PowerShell activity detected</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <rule id="100101" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.system.eventID">^1$</field>
    <field name="win.system.message" type="pcre2">(?i)(-enc|-encodedcommand)</field>
    <description>Suspicious PowerShell encoded command execution detected</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

</group>